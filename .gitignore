# Monorepo root-level ignores

# OS & Editor noise
.DS_Store
.env
.env.local
.idea/
*.iml
.vscode/
*.swp
*.swo
Thumbs.db
*.log

# Build artifacts (should stay in subdirectories only)
# Backend builds
/target/
/pom.xml
/mvnw
/mvnw.cmd
/.mvn/wrapper/maven-wrapper.jar
# Frontend builds
/node_modules/
/package-lock.json

# Root-level source directories (should not exist at root)
/src/

# Help files
HELP.md
